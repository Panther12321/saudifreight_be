{
  "name": "Naqil Organization",
  "module": "Naqil",
  "doctype": "DocType",
  "autoname": "format:ORG-.YYYY.-.#####",
  "track_changes": 1,
  "title_field": "organization_name",
  "fields": [
    {"fieldname": "organization_name", "fieldtype": "Data", "label": "Organization Name", "reqd": 1, "in_list_view": 1},
    {"fieldname": "organization_type", "fieldtype": "Select", "label": "Organization Type", "options": "Customer\nCarrier\nFleet Operator\nMarketplace Partner", "reqd": 1, "in_list_view": 1},
    {"fieldname": "status", "fieldtype": "Select", "label": "Status", "options": "Draft\nPending Verification\nActive\nSuspended\nClosed", "default": "Draft", "reqd": 1, "in_list_view": 1},
    {"fieldname": "owner_user", "fieldtype": "Link", "label": "Owner User", "options": "User", "reqd": 1},
    {"fieldname": "identity_section", "fieldtype": "Section Break", "label": "Identity"},
    {"fieldname": "commercial_registration_number", "fieldtype": "Data", "label": "Commercial Registration Number"},
    {"fieldname": "transport_license_number", "fieldtype": "Data", "label": "Transport License Number"},
    {"fieldname": "vat_number", "fieldtype": "Data", "label": "VAT Number"},
    {"fieldname": "contact_section", "fieldtype": "Section Break", "label": "Contact"},
    {"fieldname": "contact_name", "fieldtype": "Data", "label": "Primary Contact Name", "reqd": 1},
    {"fieldname": "contact_email", "fieldtype": "Data", "label": "Primary Contact Email", "options": "Email"},
    {"fieldname": "contact_phone", "fieldtype": "Data", "label": "Primary Contact Phone", "reqd": 1},
    {"fieldname": "city", "fieldtype": "Data", "label": "City"},
    {"fieldname": "verification_case", "fieldtype": "Link", "label": "Verification Case", "options": "Naqil Verification Case", "read_only": 1},
    {"fieldname": "status_reason", "fieldtype": "Small Text", "label": "Status Reason", "read_only": 1}
  ],
  "permissions": [
    {"role": "Naqil Administrator", "read": 1, "write": 1, "create": 1, "delete": 1},
    {"role": "Naqil Operations Manager", "read": 1, "write": 1, "create": 1},
    {"role": "Naqil Verification Reviewer", "read": 1},
    {"role": "Naqil Customer", "read": 1, "write": 1, "create": 1},
    {"role": "Naqil Carrier", "read": 1, "write": 1, "create": 1},
    {"role": "Naqil Fleet Manager", "read": 1, "write": 1, "create": 1}
  ]
}
