{
  "name": "Naqil Shipment",
  "module": "Naqil",
  "doctype": "DocType",
  "autoname": "format:SHP-{YYYY}-{#####}",
  "track_changes": 1,
  "title_field": "shipment_title",
  "fields": [
    {"fieldname": "shipment_title", "fieldtype": "Data", "label": "Shipment Title", "reqd": 1, "in_list_view": 1},
    {"fieldname": "customer_organization", "fieldtype": "Link", "label": "Customer Organization", "options": "Naqil Organization", "reqd": 1, "in_list_view": 1},
    {"fieldname": "created_by_customer", "fieldtype": "Link", "label": "Created By", "options": "User", "read_only": 1},
    {"fieldname": "status", "fieldtype": "Select", "label": "Status", "options": "Draft\nOpen for Bidding\nSelection Due\nAwarded\nAssigned\nPicked Up\nDelivery Evidence Submitted\nDelivered\nDisputed\nCancelled", "default": "Draft", "reqd": 1, "in_list_view": 1},
    {"fieldname": "auction_section", "fieldtype": "Section Break", "label": "Auction"},
    {"fieldname": "auction_start", "fieldtype": "Datetime", "label": "Auction Start"},
    {"fieldname": "auction_end", "fieldtype": "Datetime", "label": "Auction End", "reqd": 1},
    {"fieldname": "budget_amount", "fieldtype": "Currency", "label": "Budget Amount (SAR)"},
    {"fieldname": "priority", "fieldtype": "Select", "label": "Priority", "options": "Standard\nHigh\nUrgent", "default": "Standard"},
    {"fieldname": "offer_count", "fieldtype": "Int", "label": "Offer Count", "read_only": 1},
    {"fieldname": "lowest_offer_amount", "fieldtype": "Currency", "label": "Lowest Offer (SAR)", "read_only": 1},
    {"fieldname": "route_section", "fieldtype": "Section Break", "label": "Route and Cargo"},
    {"fieldname": "pickup_city", "fieldtype": "Data", "label": "Pickup City", "reqd": 1, "in_list_view": 1},
    {"fieldname": "pickup_address", "fieldtype": "Small Text", "label": "Pickup Address", "reqd": 1},
    {"fieldname": "pickup_window_start", "fieldtype": "Datetime", "label": "Pickup Window Start", "reqd": 1},
    {"fieldname": "pickup_window_end", "fieldtype": "Datetime", "label": "Pickup Window End", "reqd": 1},
    {"fieldname": "delivery_city", "fieldtype": "Data", "label": "Delivery City", "reqd": 1, "in_list_view": 1},
    {"fieldname": "delivery_address", "fieldtype": "Small Text", "label": "Delivery Address", "reqd": 1},
    {"fieldname": "delivery_window_end", "fieldtype": "Datetime", "label": "Delivery Deadline", "reqd": 1},
    {"fieldname": "cargo_description", "fieldtype": "Small Text", "label": "Cargo Description", "reqd": 1},
    {"fieldname": "cargo_weight_kg", "fieldtype": "Float", "label": "Cargo Weight (KG)", "reqd": 1},
    {"fieldname": "cargo_volume_cbm", "fieldtype": "Float", "label": "Cargo Volume (CBM)"},
    {"fieldname": "vehicle_type", "fieldtype": "Data", "label": "Required Vehicle Type", "reqd": 1},
    {"fieldname": "assignment_section", "fieldtype": "Section Break", "label": "Award and Assignment"},
    {"fieldname": "awarded_offer", "fieldtype": "Link", "label": "Awarded Offer", "options": "Naqil Carrier Offer", "read_only": 1},
    {"fieldname": "carrier_organization", "fieldtype": "Link", "label": "Carrier Organization", "options": "Naqil Organization", "read_only": 1},
    {"fieldname": "award_reason", "fieldtype": "Small Text", "label": "Customer Award Rationale", "read_only": 1},
    {"fieldname": "awarded_on", "fieldtype": "Datetime", "label": "Awarded On", "read_only": 1},
    {"fieldname": "delivery_evidence", "fieldtype": "Link", "label": "Delivery Evidence", "options": "Naqil Delivery Evidence", "read_only": 1}
  ],
  "permissions": [
    {"role": "Naqil Administrator", "read": 1, "write": 1, "create": 1, "delete": 1},
    {"role": "Naqil Operations Manager", "read": 1, "write": 1, "create": 1},
    {"role": "Naqil Customer", "read": 1, "write": 1, "create": 1},
    {"role": "Naqil Carrier", "read": 1},
    {"role": "Naqil Fleet Manager", "read": 1}
  ]
}
