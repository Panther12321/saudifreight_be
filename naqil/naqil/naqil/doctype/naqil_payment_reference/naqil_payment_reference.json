{
  "name": "Naqil Payment Reference",
  "module": "Naqil",
  "doctype": "DocType",
  "autoname": "format:PAYREF-{YYYY}-{#####}",
  "track_changes": 1,
  "fields": [
    {"fieldname": "invoice", "fieldtype": "Link", "label": "Invoice", "options": "Naqil Invoice", "reqd": 1, "in_list_view": 1},
    {"fieldname": "reference_type", "fieldtype": "Select", "label": "Reference Type", "options": "Collection\nRefund\nAdjustment", "reqd": 1, "in_list_view": 1},
    {"fieldname": "provider_name", "fieldtype": "Data", "label": "Payment Provider", "reqd": 1},
    {"fieldname": "provider_reference", "fieldtype": "Data", "label": "Provider Reference", "reqd": 1, "in_list_view": 1},
    {"fieldname": "amount", "fieldtype": "Currency", "label": "Amount", "reqd": 1},
    {"fieldname": "payment_status", "fieldtype": "Select", "label": "Payment Status", "options": "Recorded\nConfirmed\nFailed\nReversed", "default": "Recorded", "reqd": 1, "in_list_view": 1},
    {"fieldname": "received_on", "fieldtype": "Datetime", "label": "Received On"},
    {"fieldname": "recorded_by", "fieldtype": "Link", "label": "Recorded By", "options": "User", "read_only": 1},
    {"fieldname": "notes", "fieldtype": "Small Text", "label": "Notes"}
  ],
  "permissions": [
    {"role": "Naqil Administrator", "read": 1, "write": 1, "create": 1, "delete": 1},
    {"role": "Naqil Finance Officer", "read": 1, "write": 1, "create": 1}
  ]
}
