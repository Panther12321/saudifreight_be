{
  "name": "Naqil Invoice",
  "module": "Naqil",
  "doctype": "DocType",
  "autoname": "format:INV-.YYYY.-.#####",
  "track_changes": 1,
  "title_field": "shipment",
  "fields": [
    {"fieldname": "shipment", "fieldtype": "Link", "label": "Shipment", "options": "Naqil Shipment", "reqd": 1, "in_list_view": 1},
    {"fieldname": "bill_to_organization", "fieldtype": "Link", "label": "Bill To Organization", "options": "Naqil Organization", "reqd": 1, "in_list_view": 1},
    {"fieldname": "carrier_organization", "fieldtype": "Link", "label": "Carrier Organization", "options": "Naqil Organization", "reqd": 1},
    {"fieldname": "currency", "fieldtype": "Data", "label": "Currency", "default": "SAR", "read_only": 1},
    {"fieldname": "subtotal_amount", "fieldtype": "Currency", "label": "Carrier Offer Amount", "reqd": 1},
    {"fieldname": "commission_rate", "fieldtype": "Percent", "label": "Commission Rate (%)", "default": 5, "reqd": 1},
    {"fieldname": "commission_amount", "fieldtype": "Currency", "label": "Commission Amount", "read_only": 1},
    {"fieldname": "total_amount", "fieldtype": "Currency", "label": "Invoice Total", "read_only": 1},
    {"fieldname": "due_date", "fieldtype": "Date", "label": "Due Date", "reqd": 1},
    {"fieldname": "payment_expires_on", "fieldtype": "Datetime", "label": "Payment Expires On", "read_only": 1},
    {"fieldname": "status", "fieldtype": "Select", "label": "Status", "options": "Draft\nIssued\nPartially Paid\nPaid\nOverdue\nCancelled", "default": "Draft", "reqd": 1, "in_list_view": 1},
    {"fieldname": "issued_on", "fieldtype": "Datetime", "label": "Issued On", "read_only": 1}
  ],
  "permissions": [
    {"role": "Naqil Administrator", "read": 1, "write": 1, "create": 1, "delete": 1},
    {"role": "Naqil Finance Officer", "read": 1, "write": 1, "create": 1},
    {"role": "Naqil Operations Manager", "read": 1},
    {"role": "Naqil Customer", "read": 1},
    {"role": "Naqil Carrier", "read": 1},
    {"role": "Naqil Fleet Manager", "read": 1}
  ]
}
