    {"fieldname": "settlement_hold_hours", "fieldtype": "Int", "label": "Settlement Hold (Hours)", "default": 24, "reqd": 1},
    {"fieldname": "delivery_section", "fieldtype": "Section Break", "label": "Delivery Controls"},
