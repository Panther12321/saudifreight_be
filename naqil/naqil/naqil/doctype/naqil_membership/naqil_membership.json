{
  "name": "Naqil Membership",
  "module": "Naqil",
  "doctype": "DocType",
  "autoname": "format:MEM-{YYYY}-{#####}",
  "track_changes": 1,
  "title_field": "user",
  "fields": [
    {"fieldname": "organization", "fieldtype": "Link", "label": "Organization", "options": "Naqil Organization", "reqd": 1, "in_list_view": 1},
    {"fieldname": "user", "fieldtype": "Link", "label": "User", "options": "User", "reqd": 1, "in_list_view": 1},
    {"fieldname": "membership_role", "fieldtype": "Select", "label": "Organization Role", "options": "Owner\nOperations\nDispatcher\nFinance\nDriver Coordinator\nViewer", "reqd": 1, "in_list_view": 1},
    {"fieldname": "status", "fieldtype": "Select", "label": "Status", "options": "Invited\nActive\nSuspended\nRevoked", "default": "Invited", "reqd": 1, "in_list_view": 1},
    {"fieldname": "invited_by", "fieldtype": "Link", "label": "Invited By", "options": "User", "read_only": 1},
    {"fieldname": "activated_on", "fieldtype": "Datetime", "label": "Activated On", "read_only": 1},
    {"fieldname": "notes", "fieldtype": "Small Text", "label": "Notes"}
  ],
  "permissions": [
    {"role": "Naqil Administrator", "read": 1, "write": 1, "create": 1, "delete": 1},
    {"role": "Naqil Operations Manager", "read": 1, "write": 1, "create": 1},
    {"role": "Naqil Customer", "read": 1},
    {"role": "Naqil Carrier", "read": 1},
    {"role": "Naqil Fleet Manager", "read": 1, "write": 1, "create": 1}
  ]
}
